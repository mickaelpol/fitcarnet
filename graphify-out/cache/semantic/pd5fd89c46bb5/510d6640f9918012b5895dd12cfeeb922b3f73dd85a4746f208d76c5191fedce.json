{"nodes": [{"id": "installation_base_vierge", "label": "Installation depuis une base vierge", "file_type": "document", "source_file": "INSTALLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le sch\u00e9ma est complet d\u00e8s la cr\u00e9ation : db/01-schema.sql et db/02-donnees.sql sont ex\u00e9cut\u00e9s par PostgreSQL au tout premier d\u00e9marrage du conteneur, et seulement alors. Contr\u00f4le attendu : 12 tables, 50 aliments, 20 exercices. Pour repartir de z\u00e9ro, docker compose -f compose.dev.yml down -v."}, {"id": "installation_migrations_fusionnees", "label": "Migrations 04 \u00e0 07 fusionn\u00e9es dans le sch\u00e9ma initial", "file_type": "rationale", "source_file": "INSTALLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "04-modes, 05-catalogue, 06-correctifs et 07-perf ajoutaient apr\u00e8s coup ce qui peut \u00eatre cr\u00e9\u00e9 d'embl\u00e9e. Leur suppression \u00e9vite l'oubli au d\u00e9ploiement \u2014 une base neuve est correcte sans intervention. En contrepartie, une base existante ne recevra pas ces changements. Pour la suite, toute \u00e9volution passera par un fichier num\u00e9rot\u00e9 \u00e0 partir de 10-, jou\u00e9 explicitement."}, {"id": "installation_creer_utilisateur", "label": "fitcarnet:creer-utilisateur", "file_type": "concept", "source_file": "INSTALLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commande console qui cr\u00e9e un compte, avec --admin et --grocy pour brancher le compte sur la source de frigo Grocy."}, {"id": "installation_cibles_90", "label": "db/90-cibles.sql", "file_type": "concept", "source_file": "INSTALLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Num\u00e9rot\u00e9 90 \u00e0 dessein : il vient APR\u00c8S la cr\u00e9ation du compte, donc jamais au d\u00e9marrage automatique. Il est idempotent."}, {"id": "installation_import_catalogue", "label": "import_catalogue.py", "file_type": "concept", "source_file": "INSTALLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Importe 1 318 exercices en fran\u00e7ais depuis exercises-dataset, avec leur mode et leur rattachement Push/Pull/Legs d\u00e9duits. Simulation par d\u00e9faut, --appliquer pour \u00e9crire. Les 20 exercices personnels sont pr\u00e9serv\u00e9s et remontent en t\u00eate des listes."}, {"id": "installation_import_carnet", "label": "import_carnet.py", "file_type": "concept", "source_file": "INSTALLATION.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Importe les s\u00e9ances historiques depuis donnees-perso/carnet.json pour un email donn\u00e9. Simulation puis --appliquer."}], "edges": [{"source": "installation_base_vierge", "target": "compose_dev_db", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "INSTALLATION.md", "source_location": null, "weight": 1.0}, {"source": "installation_base_vierge", "target": "compose_dev_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "INSTALLATION.md", "source_location": null, "weight": 1.0}, {"source": "installation_base_vierge", "target": "installation_creer_utilisateur", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "INSTALLATION.md", "source_location": null, "weight": 1.0}, {"source": "installation_base_vierge", "target": "installation_cibles_90", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "INSTALLATION.md", "source_location": null, "weight": 1.0}, {"source": "installation_base_vierge", "target": "installation_import_catalog