{"nodes": [{"id": "nouvelle_machine_prerequis", "label": "Pr\u00e9requis d'une machine neuve (Docker, Node 22, jq, uv, Claude Code)", "file_type": "concept", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un PHP h\u00f4te sans dom, mbstring ni xmlwriter ne peut pas lancer PHPUnit : c'est normal, les tests tournent dans le conteneur."}, {"id": "nouvelle_machine_installer_outils", "label": "installer-outils.sh \u2014 outillage et cinq plugins", "file_type": "concept", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le contr\u00f4le compare les plugins d\u00e9clar\u00e9s aux plugins install\u00e9s : le 8 septembre 2026 il annon\u00e7ait \u00ab 5 \u00bb avec quatre sur le disque, expo ayant \u00e9chou\u00e9 sans un log."}, {"id": "nouvelle_machine_superpowers_symfony", "label": "superpowers-symfony ne s'installe pas seul", "file_type": "concept", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Son manifeste d\u00e9clare l'ancien nom d'organisation, ce qui fait tenter \u00e0 Claude Code un clone SSH refus\u00e9. \u00c0 relancer apr\u00e8s tout claude plugin marketplace update, qui efface la correction."}, {"id": "nouvelle_machine_scope_projet", "label": "claude plugin install --scope project", "file_type": "concept", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sans ce drapeau, le plugin s'active dans tous les d\u00e9p\u00f4ts de la machine."}, {"id": "nouvelle_machine_base_vide_historique", "label": "La base est vide de ton historique \u2014 apporter un dump", "file_type": "rationale", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le d\u00e9p\u00f4t porte le code, jamais les donn\u00e9es. Deux bases divergentes, c'est le m\u00eame pi\u00e8ge que deux clones du code : d\u00e9cider laquelle fait foi."}, {"id": "nouvelle_machine_plus_daliments", "label": "Il n'y a plus d'aliments de d\u00e9part, et c'est voulu", "file_type": "rationale", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Les valeurs nutritionnelles ne sont pas une constante \u2014 deux paquets de la m\u00eame chose ne portent pas les m\u00eames chiffres, et l'\u00e9tiquette fran\u00e7aise les donne. Une moyenne pos\u00e9e d'avance ne peut que tromper."}, {"id": "nouvelle_machine_sauvegarde_sh", "label": "sauvegarde.sh (--lister, --restaurer)", "file_type": "concept", "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "nouvelle_machine_prerequis", "target": "installation_base_vierge", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "weight": 1.0}, {"source": "nouvelle_machine_prerequis", "target": "deploiement_trois_chemins", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "weight": 1.0}, {"source": "nouvelle_machine_installer_outils", "target": "nouvelle_machine_superpowers_symfony", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "NOUVELLE-MACHINE.md", "source_location": null, "weight": 1.0}, {"source": "nouvelle_machine_installer_outils", "target": "nouvelle_machine_scope_projet", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "NOUVELLE-MACHINE.md", "source_lo