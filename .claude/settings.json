{
  "extraKnownMarketplaces": {
    "superpowers-symfony": {
      "source": {
        "source": "github",
        "repo": "dev-toolings/superpowers-symfony"
      }
    }
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "superpowers-symfony@superpowers-symfony": true
  },
  "skillOverrides": {
    "expo:eas-hosting": "off",
    "expo:eas-observe": "off",
    "expo:eas-simulator": "off",
    "expo:eas-update-insights": "off",
    "expo:eas-workflows": "off",
    "expo:expo-app-clip": "off",
    "expo:expo-brownfield": "off",
    "expo:expo-design-system": "off",
    "expo:expo-dom": "off",
    "expo:expo-module": "off",
    "expo:expo-native-ui": "off",
    "expo:expo-skill-feedback": "off",
    "expo:expo-web-to-native": "off",
    "superpowers-symfony:brainstorm": "off",
    "superpowers-symfony:brainstorming": "off",
    "superpowers-symfony:e2e-panther-playwright": "off",
    "superpowers-symfony:execute-plan": "off",
    "superpowers-symfony:executing-plans": "off",
    "superpowers-symfony:tdd-with-pest": "off",
    "superpowers-symfony:twig-components": "off",
    "superpowers-symfony:write-plan": "off",
    "superpowers-symfony:writing-plans": "off",
    "symfony-api-response": "off",
    "symfony-doctrine-persistence": "off",
    "symfony-messenger-async": "off",
    "symfony-security-voters": "off",
    "symfony-testing": "off",
    "symfony-validation": "off"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */front/src/*.ts|*/front/src/*.tsx|*/front/app/*.ts|*/front/app/*.tsx) cd \"${f%%/front/*}/front\" && npm run --silent verif ;; esac; }",
            "timeout": 120,
            "statusMessage": "Vérification du typage front..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */api/src/*.php|*/api/tests/*.php) docker ps --format '{{.Names}}' 2>/dev/null | grep -qx fitcarnet-app-dev || exit 0; rel=\"${f#*/api/}\"; docker exec fitcarnet-app-dev sh -c \"cd /app && vendor/bin/phpstan analyse --no-progress --error-format=raw '$rel'\" ;; esac; }",
            "timeout": 120,
            "statusMessage": "Analyse statique PHP..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/micka/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/micka/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  }
}
