{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */front/src/*.ts|*/front/src/*.tsx|*/front/app/*.ts|*/front/app/*.tsx) cd \"${f%%/front/*}/front\" && npm run --silent verif ;; esac; }",
            "timeout": 120,
            "statusMessage": "Vérification du typage front..."
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */api/src/*.php|*/api/tests/*.php) docker ps --format '{{.Names}}' 2>/dev/null | grep -qx fitcarnet-app-dev || exit 0; rel=\"${f#*/api/}\"; docker exec fitcarnet-app-dev sh -c \"cd /app && vendor/bin/phpstan analyse --no-progress --error-format=raw '$rel'\" ;; esac; }",
            "timeout": 120,
            "statusMessage": "Analyse statique PHP..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/home/micka/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/home/micka/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "superpowers-symfony@superpowers-symfony": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-harness@mickael-harness": true
  },
  "extraKnownMarketplaces": {
    "superpowers-symfony": {
      "source": {
        "source": "github",
        "repo": "dev-toolings/superpowers-symfony"
      }
    },
    "mickael-harness": {
      "source": {
        "source": "git",
        "url": "ssh://git@gitea.mickael-pol.fr:2222/mickael/claude-harness.git"
      }
    }
  },
  "env": {
    "ENABLE_LSP_TOOL": "1"
  }
}
