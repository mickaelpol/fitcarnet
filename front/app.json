{
  "expo": {
    "name": "fitcarnet",
    "slug": "fitcarnet",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitcarnet",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "fr.mickaelpol.fitcarnet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icone-adaptative.png",
        "backgroundColor": "#14161a"
      },
      "versionCode": 1,
      "usesCleartextTraffic": false
    },
    "ios": {
      "bundleIdentifier": "fr.mickaelpol.fitcarnet",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification.png",
          "color": "#e3b23c",
          "sounds": []
        }
      ],
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lancement.png",
          "backgroundColor": "#14161a",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/images/icone.png"
  }
}
