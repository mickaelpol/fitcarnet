{
  "expo": {
    "name": "fitcarnet",
    "slug": "fitcarnet",
    "version": "1.0.13",
    "orientation": "portrait",
    "scheme": "fitcarnet",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "fr.mickaelpol.fitcarnet",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icone-adaptative.png",
        "backgroundColor": "#14161a"
      },
      "versionCode": 14,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "fr.mickaelpol.fitcarnet",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification.png",
          "color": "#e3b23c",
          "sounds": [
            "./assets/sons/bois.wav",
            "./assets/sons/rappel.wav",
            "./assets/sons/harpe.wav",
            "./assets/sons/cloche.wav",
            "./assets/sons/gong.wav"
          ]
        }
      ],
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lancement.png",
          "backgroundColor": "#14161a",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8c7364c4-ad6b-493e-af6f-a62c626954ec"
    },
    "icon": "./assets/images/icone.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c7364c4-ad6b-493e-af6f-a62c626954ec"
      }
    }
  }
}
