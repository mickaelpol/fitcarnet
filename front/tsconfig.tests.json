{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "outDir": "dist-tests",
    "rootDir": "src"
  },
  "include": [
    "src/solveur/**/*.ts",
    "src/calcul/nutrition.ts",
    "src/calcul/nutrition.test.ts",
    "src/calcul/frigo.ts",
    "src/calcul/frigo.test.ts",
    "src/composants/etatMesure.ts",
    "src/composants/etatMesure.test.ts",
    "src/api/uneSeuleFois.ts",
    "src/api/uneSeuleFois.test.ts"
  ]
}
