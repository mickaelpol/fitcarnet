// Compilation des tests, jouee par `npm test`.
//
// `include` etait une LISTE ECRITE A LA MAIN des tests et de leurs dependances.
// Un nouveau .test.ts oublie dans cette liste n'etait jamais execute, sans le
// moindre signal : c'est ainsi que src/calcul/performance.ts — 1RM, volume,
// paliers — s'est retrouve sans aucun test, alors que trois constats de l'audit
// de septembre 2026 y vivent.
//
// Un motif suffit : TypeScript compile les fichiers inclus ET tout ce qu'ils
// importent, donc lister les tests amene leurs dependances toutes seules.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "outDir": "dist-tests",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.test.ts"
  ]
}
