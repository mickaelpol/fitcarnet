// Compilation des tests, jouee par `npm test`.
//
// `include` etait une LISTE ECRITE A LA MAIN des tests et de leurs dependances.
// Un nouveau .test.ts oublie dans cette liste n'etait jamais execute, sans le
// moindre signal : c'est ainsi que src/calcul/performance.ts — 1RM, volume,
// paliers — s'est retrouve sans aucun test, alors que trois constats de l'audit
// de septembre 2026 y vivent.
//
// Un motif suffit : TypeScript compile les fichiers inclus ET tout ce qu'ils
// importent, donc lister les tests amene leurs dependances toutes seules.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "strict": true,
    "esModuleInterop": true,
    // `jsx` etait absent, et son absence servait de garde-fou : un module pur
    // ne pouvait RIEN importer d'un .tsx, meme un type (TS6142). Il faut
    // l'activer pour compiler un test de rendu — voir src/tests/environnement.ts.
    // CE QUE ÇA COUTE : plus rien n'empeche un .test.ts d'importer une VALEUR
    // depuis un .tsx, et ca ne se verra plus au typage mais a l'execution, en
    // erreur de syntaxe Flow au fond de react-native.
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "outDir": "dist-tests",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.test.ts",
    // LES TESTS DE RENDU PORTENT UN AUTRE SUFFIXE, ET CE N'EST PAS COSMETIQUE.
    // `npm test` lance DEUX fois `node --test` : les tests purs nus, les tests
    // de rendu derriere `--import .../environnement.js`. Le motif `*.test.js`
    // ne peut pas attraper `*.test-rendu.js`, et c'est exactement ce qu'on veut :
    // donner un `window` aux 649 tests purs ferait basculer TanStack Query en
    // mode navigateur (gcTime 5 min au lieu d'Infinity) et api/persistance.test.ts
    // ne rendrait plus jamais la main. Mesure du 15 septembre 2026.
    "src/**/*.test-rendu.tsx",
    // l'environnement de rendu : precharge par `node --import`, donc importe
    // par aucun test, donc invisible des motifs ci-dessus.
    "src/tests/**/*.ts"
  ]
}
