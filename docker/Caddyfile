# =====================================================================
#  fitcarnet — Caddyfile
#  FrankenPHP sert l'API Symfony sous /api et le front React ailleurs.
#  Le HTTPS public est assuré par ton proxy inversé DSM : on écoute en HTTP.
# =====================================================================
{
	frankenphp
	auto_https off
	# décommente pour activer le mode worker (perf x3, à valider en usage) :
	# frankenphp {
	#     worker ./public/index.php 2
	# }
}

:80 {
	log {
		output stderr
		format console
	}

	encode zstd gzip

	# ---------- en-tetes de securite ----------
	#
	# AUCUN N'ETAIT SERVI (constat F-03, 7 septembre 2026). Ni sur le front,
	# ni sur l'API, ni sur `/telecharger`.
	#
	# ICI ET PAS DANS LES BLOCS `handle`, ET C'EST LE POINT IMPORTANT.
	#
	# Le rapport d'audit proposait « trois lignes dans le bloc handle du
	# front ». Ce site en a QUATRE, de blocs : /api*, /bundles/*,
	# /telecharger/* et le front. Poser la regle dans un seul, c'est le motif
	# de defaut dominant de ce projet — une decision juste appliquee a un
	# endroit et oubliee aux autres, et le cinquieme bloc naitrait sans.
	# Au niveau du site, les quatre sont couverts et le prochain aussi.
	#
	# CE QUE CHACUN ACHETE :
	#
	#  - `X-Content-Type-Options: nosniff` — un navigateur cesse de deviner le
	#    type d'un fichier a partir de son contenu. Sans lui, un fichier
	#    televerse et reservi peut etre execute comme du HTML ou du script
	#    parce que le navigateur en a decide ainsi, contre le Content-Type.
	#
	#  - `X-Frame-Options: DENY` — l'application ne peut pas etre encadree par
	#    un site tiers. C'est la seule protection contre le detournement de
	#    clic : une page qui superpose un cadre invisible de fitcarnet a ses
	#    propres boutons, et fait cliquer chez nous ce qu'on croit cliquer
	#    chez elle.
	#
	#  - `Referrer-Policy: strict-origin-when-cross-origin` — vers l'exterieur,
	#    seul le domaine part, jamais le chemin. Une adresse d'API porte des
	#    identifiants ; elle n'a rien a faire dans les journaux d'un tiers.
	#
	# CE QUI N'EST PAS POSE ICI, ET POURQUOI :
	#
	#  - `Strict-Transport-Security` : le HTTPS public est termine par le
	#    proxy inverse DSM, en amont. Ce Caddy-ci ecoute en HTTP clair
	#    (`auto_https off`, `:80`) et ne sait pas si la requete est arrivee
	#    chiffree. Un HSTS emis d'ici serait un pari, pas une garantie. Sa
	#    place est dans DSM, et rien de ce depot ne peut le verifier.
	#
	#  - `Content-Security-Policy` : le front est un bundle Expo web dont on
	#    ne connait pas, sans mesure, les sources exactes (styles en ligne,
	#    fontes, blob:). Une politique posee au jugé casse l'application en
	#    silence chez l'utilisateur et pas chez soi. A faire un jour, en
	#    `Content-Security-Policy-Report-Only` d'abord.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# ---------- API Symfony ----------
	handle /api* {
		root * /app/public
		php_server
	}

	# ---------- assets des bundles (interface API Platform, profiler…) ----------
	handle /bundles/* {
		root * /app/public
		file_server
	}
	# LE PROFILEUR N'EST PAS ROUTE EN PRODUCTION.
	#
	# Il l'etait, « au cas ou ». Le paquet n'est pas installe en prod —
	# `composer install --no-dev` l'ecarte — donc ces adresses tombaient sur
	# une erreur Symfony plutot que sur le profileur. Mais router vers un
	# outil qui expose requetes SQL, variables d'environnement et contenu des
	# sessions est une porte qu'on laisse en place en pariant qu'elle reste
	# verrouillee. Le pari se perd le jour ou quelqu'un installe les
	# dependances de developpement sur le NAS pour deboguer, et l'oublie.
	#
	# En developpement, `compose.dev.yml` sert l'application autrement et le
	# profileur y reste accessible.

	# ---------- l'APK Android, et ce qui dit sa version ----------
	#
	#  Android interdit a une application d'en installer une autre sans que
	#  l'utilisateur appuie sur « Installer ». On ne peut donc pas pousser un
	#  APK ; on peut seulement le POSER quelque part et dire qu'il existe.
	#  C'est ce que sert ce bloc : `version.json` que l'application interroge
	#  au demarrage, et l'APK a cote.
	#
	#  L'APK lui-meme est HORS du depot — des dizaines de megaoctets n'ont
	#  rien a faire dans git. Il est depose a la main sur le disque du NAS,
	#  dans le meme dossier que `index.html` et `version.json`, eux versionnes.
	#
	#  `handle_path` ET PAS `handle`, ET C'EST TOUTE LA DIFFERENCE.
	#
	#  `handle` ne retire pas le prefixe de l'URL. Avec `root * /telecharger`,
	#  une requete sur `/telecharger/fitcarnet.apk` allait donc chercher
	#  `/telecharger/telecharger/fitcarnet.apk`, qui n'existe pas : 404 sur
	#  l'APK ET sur `version.json`, donc aucune mise a jour jamais proposee,
	#  et rien nulle part qui dise pourquoi.
	#
	#  `handle_path` retire le prefixe avant de servir. Les motifs ci-dessous
	#  voient donc l'URL SANS `/telecharger`, d'ou `/version.json`.
	handle_path /telecharger/* {
		root * /telecharger
		# Sans ce type, le navigateur Android telecharge un fichier qu'il ne
		# sait pas ouvrir, et rien ne se passe au moment du clic.
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		# `version.json` doit etre relu a chaque fois : mis en cache, un
		# telephone continuerait d'ignorer une version publiee la veille.
		@manifeste path /version.json
		header @manifeste Cache-Control "no-store"
		# `index.html` dit les trois gestes qu'Android impose pour installer
		# une application venue d'ailleurs que du Play Store. Sans elle, un
		# lien vers l'APK suffit a bloquer quelqu'un qui ne les connait pas.
		file_server browse {
			index index.html
		}
	}

	# ---------- front React ----------
	handle {
		root * /app/front
		# assets versionnés : cache long
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# LE PLUS GROS FICHIER DU SITE N'ETAIT COUVERT PAR AUCUNE REGLE.
		#
		# `expo export --platform web` ne range pas tout sous /assets : le paquet
		# JavaScript, de loin le plus lourd, sort dans
		# `/_expo/static/js/web/entry-<empreinte>.js`. Le motif `/assets/*` ne le
		# voyait donc jamais, et il repartait a chaque visite sans la moindre
		# consigne de cache — pour un fichier qui ne change pas.
		#
		# Il porte deja son empreinte dans son nom : le garder un an est sans
		# risque, une publication produit un autre nom.
		@statiques path /_expo/*
		header @statiques Cache-Control "public, max-age=31536000, immutable"
		# index.html : jamais mis en cache, sinon les mises à jour ne passent pas
		header /index.html Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
