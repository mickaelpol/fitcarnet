# fitcarnet — variables de la stack de PRODUCTION (NAS)
# En déploiement Portainer « Web editor », ces valeurs se saisissent
# directement dans la section « Environment variables » de la stack.
DB_PASSWORD=change_moi_mot_de_passe_long
APP_SECRET=change_moi_32_caracteres_aleatoires
JWT_PASSPHRASE=change_moi_passphrase_des_cles_jwt

# ---------------------------------------------------------------------
#  Grocy — la base d'aliments du compte administrateur.
#
#  Laisse vide si personne n'utilise Grocy : l'application le détectera et
#  l'expliquera plutôt que d'échouer.
#
#  Les valeurs nutritionnelles doivent avoir été posées par le script
#  ciqual_vers_grocy.py, sans quoi les produits resteront invisibles.
# ---------------------------------------------------------------------
GROCY_URL=https://grocy.exemple.fr
GROCY_API_KEY=
